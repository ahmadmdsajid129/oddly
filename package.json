{
  "name": "oddly",
  "version": "1.0.0",
  "private": true,
  "description": "Oddly v1 — Daily five-pick game finding your stranger twin",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "db:migrate": "echo 'Stage 2 task: prisma migrate dev'",
    "db:seed": "echo 'Stage 2 task: prisma db seed'"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  }
}
