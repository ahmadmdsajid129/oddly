{
  "name": "oddly",
  "version": "1.0.0",
  "private": true,
  "description": "Oddly v1 — Daily five-pick game finding your stranger twin",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "size-limit": "node scripts/check-bundle-budget.mjs",
    "verify:matching": "node tools/verify-math-logic.mjs",
    "bench:partition": "pnpm --filter @oddly/shared exec tsx scripts/bench-partition.ts",
    "ops:sever-orbit": "node tools/ops-sever-orbit.mjs",
    "ops:ban-player": "node tools/ops-ban-player.mjs",
    "explain:twin": "node tools/explain-twin.mjs",
    "seed:200-scenario": "node tools/seed-200-scenario.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "db:migrate": "echo 'Stage 2 task: prisma migrate dev'",
    "db:seed": "echo 'Stage 2 task: prisma db seed'"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@size-limit/file": "^14.3.0",
    "@types/opossum": "^8.1.9",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "size-limit": "^14.3.0",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "opossum": "^10.0.0",
    "prom-client": "^15.1.3"
  },
  "pnpm": {
    "overrides": {
      "zod-to-json-schema": "3.24.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ]
  }
}
