// Oddly v1 — Prisma Schema
// packages/shared/prisma/schema.prisma
// All 18 tables. Everything dynamic comes from the DB.
// D-005: No hardcoded questions/copy/config in code.

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum DropStatus {
  pending
  live
  closed
}

enum QuestionType {
  text
  number
  colour
  image
  word
}

enum ShareFormat {
  story
  square
  link
}

enum TierEnum {
  Common
  Uncommon
  Rare
  Mythic
}

enum ReportReason {
  offensive
  spam
  incorrect
  other
}

enum KeepStatus {
  pending
  accepted
  declined
  expired
}

enum OrbitStatus {
  active
  ended
}

// ---------------------------------------------------------------------------
// 1. accounts — optional Google-linked account (may be null for guest players)
// ---------------------------------------------------------------------------
model Account {
  id           String    @id @default(uuid())
  google_sub   String    @unique
  email_hash   String    // SHA-256 of email, never store plaintext
  display_name String    @db.VarChar(50)
  created_at   DateTime  @default(now())
  deleted_at   DateTime?

  players Player[]

  @@map("accounts")
}

// ---------------------------------------------------------------------------
// 2. players — a device (guest). May be linked to an Account.
// ---------------------------------------------------------------------------
model Player {
  id              String    @id @default(uuid())
  did             String    @unique @db.VarChar(128) // device fingerprint
  account_id      String?
  account         Account?  @relation(fields: [account_id], references: [id])
  region          String    @db.VarChar(10)   // ISO 3166-1 alpha-2 (e.g. "IN")
  age_band        String    @db.VarChar(10)   // "18-24", "25-34", etc.
  push_token_enc  String?   @db.Text          // AES-256-GCM encrypted push token
  created_at      DateTime  @default(now())
  is_synthetic    Boolean?  @default(false)

  submissions      Submission[]
  streakLogs       StreakLog[]
  pushSubscriptions PushSubscription[]
  matchesAsA       Match[]  @relation("PlayerA")
  matchesAsB       Match[]  @relation("PlayerB")
  reports          Report[]
  keepsSent        TwinKeep[] @relation("KeepFrom")
  keepsReceived    TwinKeep[] @relation("KeepTo")
  orbitsAsA        Orbit[]    @relation("OrbitPlayerA")
  orbitsAsB        Orbit[]    @relation("OrbitPlayerB")
  orbitExpressions OrbitExpression[]
  telepathyGuesses TelepathyGuess[]
  antiTwinResults  AntiTwinResult[]
  consents         Consent[]
  analyticsId      AnalyticsId?
  memeSubmissions  MemeSubmission[]
  memeRatings      MemeRating[]
  memeExposures    MemeExposure[]
  playerTastes     PlayerTaste[]
  creatorBadges    CreatorBadge[]
  subscriptions    Subscription[]
  paywallEvents    PaywallEvent[]
  laneInterests    LaneInterest[]
  lanePrefs        PlayerLanePref[]
  laneHistorySignatures LaneHistorySignature[]
  blocksInitiated  Block[]    @relation("Blocker")
  blocksReceived   Block[]    @relation("Blocked")
  collectorBadges  CollectorBadge[]

  @@index([account_id])
  @@index([did])
  @@map("players")
}

// ---------------------------------------------------------------------------
// 3. drops — one per day (07:00 IST open, 23:59 IST close)
// ---------------------------------------------------------------------------
model Drop {
  id                    String     @id @default(uuid())
  drop_date             DateTime   @db.Date // YYYY-MM-DD in IST
  opens_at              DateTime                    // UTC timestamp for 07:00 IST
  closes_at             DateTime                    // UTC timestamp for 23:59 IST
  status                DropStatus @default(pending)
  telepathy_question_id String?
  telepathy_question    Question?  @relation("DropTelepathyQuestion", fields: [telepathy_question_id], references: [id])
  theme_key             String?    @db.VarChar(50)
  lane_id               String?
  lane                  Lane?      @relation(fields: [lane_id], references: [id])
  created_at            DateTime   @default(now())

  questions    Question[]
  submissions  Submission[]
  matches      Match[]
  streakLogs   StreakLog[]
  reports      Report[]
  batchRuns    BatchRun[]

  @@unique([lane_id, drop_date])
  @@index([drop_date])
  @@index([status])
  @@index([telepathy_question_id])
  @@index([theme_key])
  @@index([lane_id])
  @@map("drops")
}

// ---------------------------------------------------------------------------
// 4. questions — 5 per drop, polymorphic via JSONB payload
// ---------------------------------------------------------------------------
model Question {
  id                 String        @id @default(uuid())
  drop_id            String
  drop               Drop          @relation(fields: [drop_id], references: [id])
  lane_id            String?
  lane               Lane?         @relation(fields: [lane_id], references: [id])
  position           Int           @db.SmallInt // 1-5
  type               QuestionType
  format             String        @default("pick1") @db.VarChar(20)
  render_variant     String        @default("standard") @db.VarChar(20) // "standard" | "meme"
  template_id        String?
  memeTemplate       MemeTemplate? @relation(fields: [template_id], references: [id])
  payload            Json          // discriminated by type (see D-006)
  options            Json?
  subject_tags       Json?
  scene_asset_key    String?       @db.VarChar(100)
  entropy_estimate   Float?
  tie_risk_estimate  Float?
  created_at         DateTime      @default(now())

  answerOptions      AnswerOption[]
  telepathyForDrops  Drop[]            @relation("DropTelepathyQuestion")
  telepathyGuesses   TelepathyGuess[]
  questionTags       QuestionTag[]
  statsDaily         QuestionStatsDaily[]

  @@unique([drop_id, position])
  @@index([drop_id])
  @@index([lane_id])
  @@index([render_variant])
  @@index([template_id])
  @@map("questions")
}

// ---------------------------------------------------------------------------
// 5. answer_options — static choices for a question
// ---------------------------------------------------------------------------
model AnswerOption {
  id               String   @id @default(uuid())
  question_id      String
  question         Question @relation(fields: [question_id], references: [id])
  label            String   @db.VarChar(200)
  value            String   @db.VarChar(200) // canonical value used in matching
  display_order    Int      @db.SmallInt
  illustration_key String?  @db.VarChar(100) // links to SVG registry (Q-Type 4)

  @@index([question_id])
  @@map("answer_options")
}

// ---------------------------------------------------------------------------
// 6. submissions — range-partitioned by drop_date (R2.1)
// ---------------------------------------------------------------------------
model Submission {
  id           String   @default(uuid())
  drop_id      String
  drop_date    DateTime @db.Date
  drop         Drop     @relation(fields: [drop_id], references: [id])
  lane_id      String?
  player_id    String
  player       Player   @relation(fields: [player_id], references: [id])
  request_id   String   @db.VarChar(64) // client-generated idempotency key
  answers      Json     // array of {question_id, value} — matches AnswerPayload[]
  submitted_at DateTime @default(now())
  is_bot_flagged Boolean @default(false)
  is_synthetic Boolean? @default(false)

  oddnessScore      OddnessScore?
  shareCards        ShareCard[]
  submissionAnswers SubmissionAnswer[]

  @@id([id, drop_date])
  @@unique([drop_date, request_id])
  @@unique([drop_date, player_id])
  @@index([drop_date])
  @@index([drop_id])
  @@index([player_id])
  @@index([submitted_at])
  @@index([drop_date, lane_id])
  @@map("submissions")
}

// ---------------------------------------------------------------------------
// 6b. submission_answers — normalized answers partitioned by drop_date (R2.1)
// ---------------------------------------------------------------------------
model SubmissionAnswer {
  id            String     @default(uuid())
  submission_id String
  drop_id       String
  drop_date     DateTime   @db.Date
  lane_id       String?
  player_id     String
  question_id   String
  value         String     @db.VarChar(200)
  created_at    DateTime   @default(now())

  submission    Submission @relation(fields: [submission_id, drop_date], references: [id, drop_date])

  @@id([id, drop_date])
  @@index([drop_date, question_id, value])
  @@index([drop_date, player_id])
  @@index([drop_date, lane_id])
  @@map("submission_answers")
}

// ---------------------------------------------------------------------------
// 7. answer_stats — running probability per question value partitioned by drop_date (R2.1)
// ---------------------------------------------------------------------------
model AnswerStat {
  id          String   @default(uuid())
  drop_id     String
  drop_date   DateTime @db.Date
  question_id String
  value       String   @db.VarChar(200)
  count       Int      @default(0)
  probability Float    @default(0) // count / total_submissions_for_drop
  updated_at  DateTime @default(now())

  @@id([id, drop_date])
  @@unique([drop_date, question_id, value])
  @@index([drop_date])
  @@index([question_id])
  @@map("answer_stats")
}

// ---------------------------------------------------------------------------
// 8. matches — pairwise match for a drop partitioned by drop_date (R2.1)
// ---------------------------------------------------------------------------
model Match {
  id                  String    @default(uuid())
  drop_id             String
  drop_date           DateTime  @db.Date
  drop                Drop      @relation(fields: [drop_id], references: [id])
  lane_id             String?
  player_a_id         String
  player_a            Player    @relation("PlayerA", fields: [player_a_id], references: [id])
  player_b_id         String
  player_b            Player    @relation("PlayerB", fields: [player_b_id], references: [id])
  submission_a_id     String?
  submission_b_id     String?
  similarity_score    Float     // dice coefficient [0, 1]
  tie_group_size      Int       @default(1)
  is_mutual           Boolean   @default(true)
  tie_break_reason    String    @default("similarity") @db.VarChar(30)
  questions_compared  Int       @default(5)
  history_days        Int       @default(0)
  is_provisional      Boolean   @default(true)  // true until drop closes
  is_synthetic        Boolean?  @default(false)
  matched_at          DateTime  @default(now())
  finalized_at        DateTime?

  @@id([id, drop_date])
  @@unique([drop_date, player_a_id])
  @@unique([drop_date, player_b_id])
  @@index([drop_date])
  @@index([drop_id])
  @@index([player_a_id])
  @@index([player_b_id])
  @@index([drop_date, lane_id])
  @@map("matches")
}

// ---------------------------------------------------------------------------
// 9. oddness_scores — computed after drop closes
// ---------------------------------------------------------------------------
model OddnessScore {
  id            String     @id @default(uuid())
  submission_id String
  drop_date     DateTime   @db.Date
  submission    Submission @relation(fields: [submission_id, drop_date], references: [id, drop_date])
  lane_id       String?
  lane          Lane?      @relation(fields: [lane_id], references: [id])
  raw_score     Float      // weighted entropy [0, 1]
  percentile    Float      // 0-100 within day's cohort
  tier          TierEnum

  @@unique([submission_id, drop_date])
  @@index([submission_id])
  @@index([tier])
  @@index([lane_id])
  @@map("oddness_scores")
}

// ---------------------------------------------------------------------------
// 10. streak_logs — one row per player per drop they participated in
// ---------------------------------------------------------------------------
model StreakLog {
  id             String   @id @default(uuid())
  player_id      String
  player         Player   @relation(fields: [player_id], references: [id])
  drop_id        String
  drop           Drop     @relation(fields: [drop_id], references: [id])
  streak_count   Int      @default(1)
  calculated_at  DateTime @default(now())

  @@unique([player_id, drop_id])
  @@index([player_id])
  @@map("streak_logs")
}

// ---------------------------------------------------------------------------
// 11. share_cards — generated PNG/story/square card per submission
// ---------------------------------------------------------------------------
model ShareCard {
  id            String      @id @default(uuid())
  submission_id String
  drop_date     DateTime    @db.Date
  submission    Submission  @relation(fields: [submission_id, drop_date], references: [id, drop_date])
  format        ShareFormat
  storage_key   String      @db.Text // S3/R2 object key
  generated_at  DateTime    @default(now())

  @@unique([submission_id, format])
  @@index([submission_id])
  @@map("share_cards")
}

// ---------------------------------------------------------------------------
// 12. short_links — 6-char slug for share URLs
// ---------------------------------------------------------------------------
model ShortLink {
  id            String     @id @default(uuid())
  short_id      String     @unique @db.VarChar(8) // e.g. "xK9mP2"
  submission_id String
  created_at    DateTime   @default(now())
  views         Int        @default(0)

  @@index([short_id])
  @@map("short_links")
}

// ---------------------------------------------------------------------------
// 13. push_subscriptions — Web Push subscription endpoint + keys
// ---------------------------------------------------------------------------
model PushSubscription {
  id         String   @id @default(uuid())
  player_id  String
  player     Player   @relation(fields: [player_id], references: [id])
  endpoint   String   @db.Text
  keys       Json     // { p256dh: string, auth: string }
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@unique([player_id, endpoint])
  @@index([player_id])
  @@index([is_active])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// 14. app_content — all UI strings, by locale key (D-005)
// ---------------------------------------------------------------------------
model AppContent {
  id         String   @id @default(uuid())
  key        String   @db.VarChar(200)
  locale     String   @db.VarChar(10) @default("en")
  value      String   @db.Text
  updated_at DateTime @updatedAt

  @@unique([key, locale])
  @@index([key])
  @@map("app_content")
}

// ---------------------------------------------------------------------------
// 15. app_config — feature flags and runtime settings (D-005)
// ---------------------------------------------------------------------------
model AppConfig {
  id         String   @id @default(uuid())
  key        String   @unique @db.VarChar(200)
  value      Json     // any JSON value
  updated_at DateTime @updatedAt

  @@map("app_config")
}

// ---------------------------------------------------------------------------
// 16. tier_definitions — dynamic tier thresholds (D-005)
// ---------------------------------------------------------------------------
model TierDefinition {
  id              String   @id @default(uuid())
  tier            TierEnum @unique
  min_percentile  Float
  max_percentile  Float
  label           String   @db.VarChar(50)
  description     String   @db.Text
  badge_color     String   @db.VarChar(20) // hex or CSS colour token

  @@map("tier_definitions")
}

// ---------------------------------------------------------------------------
// 17. pages — CMS-managed static pages (About, Privacy, FAQ)
// ---------------------------------------------------------------------------
model Page {
  id         String   @id @default(uuid())
  slug       String   @unique @db.VarChar(100)
  title      String   @db.VarChar(200)
  body_md    String   @db.Text
  updated_at DateTime @updatedAt

  @@map("pages")
}

// ---------------------------------------------------------------------------
// 18. reports — player reporting another submission
// ---------------------------------------------------------------------------
model Report {
  id          String       @id @default(uuid())
  reporter_id String
  reporter    Player       @relation(fields: [reporter_id], references: [id])
  drop_id     String
  drop        Drop         @relation(fields: [drop_id], references: [id])
  submission_id String
  reason      ReportReason
  note        String?      @db.Text
  created_at  DateTime     @default(now())

  @@index([drop_id])
  @@index([reporter_id])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// 19. batch_runs — chunked resumable final batch progress tracking (R1.1)
// ---------------------------------------------------------------------------
model BatchRun {
  id           String    @id @default(uuid())
  drop_id      String
  drop         Drop      @relation(fields: [drop_id], references: [id])
  chunk_index  Int
  cursor_from  String?   @db.VarChar(128)
  cursor_to    String?   @db.VarChar(128)
  player_count Int       @default(0)
  status       String    @db.VarChar(20) // pending | processing | completed | failed
  attempts     Int       @default(0)
  started_at   DateTime?
  completed_at DateTime?
  error        String?   @db.Text
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@unique([drop_id, chunk_index])
  @@index([drop_id, status])
  @@map("batch_runs")
}

// ---------------------------------------------------------------------------
// 20. scheduler_runs — idempotent leader tracking for daily crons (R1.1)
// ---------------------------------------------------------------------------
model SchedulerRun {
  id           String    @id @default(uuid())
  job_name     String    @db.VarChar(100) // stageDrop | openDrop | closeDrop | matchFinal
  run_for      String    @db.VarChar(100) // drop_date (e.g. "2026-11-10") or drop_id
  status       String    @db.VarChar(20)  // running | completed | failed
  started_at   DateTime  @default(now())
  completed_at DateTime?
  error        String?   @db.Text

  @@unique([job_name, run_for])
  @@index([job_name, run_for, status])
  @@map("scheduler_runs")
}

// ---------------------------------------------------------------------------
// 21. user_history_summaries — compacted daily player summaries for 90-day retention (R2.1)
// ---------------------------------------------------------------------------
model UserHistorySummary {
  id               String   @id @default(uuid())
  player_id        String
  account_id       String?
  drop_id          String
  drop_date        DateTime @db.Date
  similarity_score Float
  oddness_score    Float
  percentile       Float
  tier             String   @db.VarChar(32)
  twin_player_id   String?
  twin_region      String?  @db.VarChar(10)
  summary_json     Json
  created_at       DateTime @default(now())

  @@unique([player_id, drop_date])
  @@index([player_id])
  @@index([drop_date])
  @@map("user_history_summaries")
}

// ---------------------------------------------------------------------------
// 22. partition_alerts — records any fallback rows caught by DEFAULT partition (R2.1)
// ---------------------------------------------------------------------------
model PartitionAlert {
  id            String   @id @default(uuid())
  table_name    String
  drop_date     DateTime @db.Date
  row_id        String
  alert_message String
  created_at    DateTime @default(now())

  @@map("partition_alerts")
}

// ---------------------------------------------------------------------------
// 23. twin_keeps — private symmetric requests to establish an Orbit (Stage F1 / Phase 10A)
// Range-partitioned by drop_date
// ---------------------------------------------------------------------------
model TwinKeep {
  id                  String     @default(uuid())
  drop_date           DateTime   @db.Date
  lane_id             String?
  from_player_id      String
  from_player         Player     @relation("KeepFrom", fields: [from_player_id], references: [id])
  to_player_id        String
  to_player           Player     @relation("KeepTo", fields: [to_player_id], references: [id])
  status              KeepStatus @default(pending)
  similarity_snapshot Float
  created_at          DateTime   @default(now())
  decided_at          DateTime?

  @@id([id, drop_date])
  @@unique([drop_date, from_player_id])
  @@index([drop_date])
  @@index([to_player_id, status])
  @@index([from_player_id, drop_date])
  @@index([lane_id])
  @@map("twin_keeps")
}

// ---------------------------------------------------------------------------
// 24. orbits — mutual long-running relationship between two players (Stage F1 / Phase 10A)
// Invariant: player_a_id < player_b_id (lexicographical sorting)
// ---------------------------------------------------------------------------
model Orbit {
  id                String      @id @default(uuid())
  lane_id           String?
  player_a_id       String
  player_a          Player      @relation("OrbitPlayerA", fields: [player_a_id], references: [id])
  player_b_id       String
  player_b          Player      @relation("OrbitPlayerB", fields: [player_b_id], references: [id])
  status            OrbitStatus @default(active)
  started_on        DateTime    @db.Date
  ended_on          DateTime?   @db.Date
  co_streak_current Int         @default(0)
  co_streak_best    Int         @default(0)
  last_co_date      DateTime?   @db.Date
  ended_by          String?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @default(now()) @updatedAt

  unlock_state      String      @default("locked") @db.VarChar(20)
  unlocked_by       String?     @db.VarChar(20)
  unlocked_at       DateTime?
  chat_state        String      @default("closed") @db.VarChar(20)
  consent_player_id String?
  consent_at        DateTime?

  expressions       OrbitExpression[]
  telepathyGuesses  TelepathyGuess[]
  subjectSyncs      OrbitSubjectSync[]
  trials            OrbitTrial[]

  @@index([player_a_id, status])
  @@index([player_b_id, status])
  @@index([lane_id])
  @@map("orbits")
}

// ---------------------------------------------------------------------------
// 25. orbit_expressions — lightweight daily one-tap non-verbal sticker interactions (The Wave)
// Range-partitioned by drop_date
// ---------------------------------------------------------------------------
model OrbitExpression {
  id             String   @default(uuid())
  orbit_id       String
  orbit          Orbit    @relation(fields: [orbit_id], references: [id])
  lane_id        String?
  from_player_id String
  from_player    Player   @relation(fields: [from_player_id], references: [id])
  drop_date      DateTime @db.Date
  expression_key String   @db.VarChar(50)
  created_at     DateTime @default(now())

  @@id([id, drop_date])
  @@unique([orbit_id, from_player_id, drop_date])
  @@index([orbit_id, drop_date])
  @@map("orbit_expressions")
}

// ---------------------------------------------------------------------------
// 26. telepathy_guesses — daily instinct guessing inside Orbits (Stage F3 / Phase 10C)
// Range-partitioned by drop_date, 90-day retention
// ---------------------------------------------------------------------------
model TelepathyGuess {
  id                 String   @default(uuid())
  orbit_id           String
  orbit              Orbit    @relation(fields: [orbit_id], references: [id], onDelete: Cascade)
  lane_id            String?
  drop_date          DateTime @db.Date
  guesser_player_id  String
  guesser_player     Player   @relation(fields: [guesser_player_id], references: [id], onDelete: Cascade)
  question_id        String
  question           Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  guessed_option_key String
  partner_option_key String?
  hit                Boolean?
  baseline_p         Float    @default(0.25)
  created_at         DateTime @default(now())

  @@id([id, drop_date])
  @@unique([orbit_id, drop_date, guesser_player_id])
  @@index([drop_date])
  @@index([orbit_id, drop_date])
  @@index([guesser_player_id, drop_date])
  @@map("telepathy_guesses")
}

// ---------------------------------------------------------------------------
// 27. anti_twin_results — asynchronously computed opposite match per user (Stage F4 / Phase 10D)
// 7-day rolling retention, zero opposite pick exposure
// ---------------------------------------------------------------------------
model AntiTwinResult {
  drop_date               DateTime @db.Date
  player_id               String
  player                  Player   @relation(fields: [player_id], references: [id], onDelete: Cascade)
  lane_id                 String?
  lane                    Lane?    @relation(fields: [lane_id], references: [id])
  opposite_submission_ref String
  differed_count          Int
  sample_size             Int
  computed_at             DateTime @default(now())

  @@id([drop_date, player_id])
  @@index([drop_date])
  @@index([player_id])
  @@index([lane_id])
  @@map("anti_twin_results")
}

// ---------------------------------------------------------------------------
// 28. tags — neutral subject taxonomy (Stage M1 / Phase 10E / F24)
// ---------------------------------------------------------------------------
model Tag {
  id         String   @id @default(uuid())
  key        String   @unique @db.VarChar(50)
  label_i18n Json     // localized labels { en: "Humour", ... }
  category   String   @db.VarChar(30)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  questionTags QuestionTag[]
  statsDaily   TagStatsDaily[]
  playerTastes PlayerTaste[]
  editorSuggestions EditorSuggestion[]

  @@index([key])
  @@index([category])
  @@map("tags")
}

// ---------------------------------------------------------------------------
// 29. question_tags — many-to-many link between questions and subject tags (Stage M1 / Phase 10E)
// ---------------------------------------------------------------------------
model QuestionTag {
  question_id String
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  tag_id      String
  tag         Tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())

  @@id([question_id, tag_id])
  @@index([question_id])
  @@index([tag_id])
  @@map("question_tags")
}

// ---------------------------------------------------------------------------
// 30. meme_templates — curated vector SVG illustration templates (Stage M1 / Phase 10E / F24)
// ---------------------------------------------------------------------------
model MemeTemplate {
  id                        String   @id @default(uuid())
  key                       String   @unique
  illustration_registry_key String
  aspect                    String   @default("1:1")
  alt_text_i18n             Json
  license_note              String
  status                    String   @default("active") @db.VarChar(20)
  created_at                DateTime @default(now())

  questions       Question[]
  memeSubmissions MemeSubmission[]

  @@index([key])
  @@index([status])
  @@map("meme_templates")
}

// ---------------------------------------------------------------------------
// 31. consents — granular, withdrawable DPDP consent records (Stage M2 / Phase 10F)
// ---------------------------------------------------------------------------
model Consent {
  id             String    @id @default(uuid())
  player_id      String
  player         Player    @relation(fields: [player_id], references: [id], onDelete: Cascade)
  purpose        String    @db.VarChar(30) // 'analytics' | 'personalisation'
  policy_version Int       @default(1)
  granted_at     DateTime  @default(now())
  withdrawn_at   DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt

  @@unique([player_id, purpose], name: "player_purpose")
  @@index([player_id])
  @@index([purpose])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// 32. analytics_ids — 1:1 pseudonymous identity severance table (Stage M2 / Phase 10F)
// ---------------------------------------------------------------------------
model AnalyticsId {
  player_id    String   @id
  player       Player   @relation(fields: [player_id], references: [id], onDelete: Cascade)
  analytics_id String   @unique @default(uuid())
  created_at   DateTime @default(now())

  @@index([analytics_id])
  @@map("analytics_ids")
}

// ---------------------------------------------------------------------------
// 33. events_raw — high-throughput, consented telemetry events (Stage M2 / Phase 10F)
// Range-partitioned by drop_date, 90-day retention
// ---------------------------------------------------------------------------
model EventRaw {
  id           String   @default(uuid())
  analytics_id String
  drop_date    DateTime @db.Date
  event_name   String   @db.VarChar(50)
  props        Json     @default("{}")
  session_id   String?  @db.VarChar(64)
  created_at   DateTime @default(now())

  @@id([drop_date, id])
  @@index([analytics_id])
  @@index([event_name])
  @@map("events_raw")
}

// ---------------------------------------------------------------------------
// 34. question_stats_daily — nightly aggregated question quality metrics (Stage M2 / Phase 10F)
// ---------------------------------------------------------------------------
model QuestionStatsDaily {
  drop_date      DateTime @db.Date
  question_id    String
  question       Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  shown_count    Int      @default(0)
  answered_count Int      @default(0)
  dwell_p50_ms   Int      @default(0)
  dwell_p90_ms   Int      @default(0)
  change_rate    Float    @default(0.0)
  back_rate      Float    @default(0.0)
  abandon_rate   Float    @default(0.0)
  report_rate    Float    @default(0.0)
  entropy        Float    @default(0.0)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  @@id([drop_date, question_id])
  @@index([question_id])
  @@map("question_stats_daily")
}

// ---------------------------------------------------------------------------
// 35. tag_stats_daily — nightly aggregated performance by subject tag (Stage M2 / Phase 10F)
// ---------------------------------------------------------------------------
model TagStatsDaily {
  drop_date    DateTime @db.Date
  tag_id       String
  tag          Tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  completions  Int      @default(0)
  share_count  Int      @default(0)
  dwell_p50_ms Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@id([drop_date, tag_id])
  @@index([tag_id])
  @@map("tag_stats_daily")
}

// ---------------------------------------------------------------------------
// 36. meme_submissions — user caption submissions for Meme Lab (Stage M3 / Phase 10G)
// Rule 18: Scoped free-text exception strictly <= 100 characters
// ---------------------------------------------------------------------------
model MemeSubmission {
  id                      String    @id @default(uuid())
  author_player_id        String
  author                  Player    @relation(fields: [author_player_id], references: [id], onDelete: Cascade)
  template_id             String
  template                MemeTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  caption_text            String    @db.VarChar(100)
  status                  String    @default("queued") @db.VarChar(20) // 'queued' | 'approved' | 'rejected' | 'retired'
  turnstile_verified      Boolean   @default(true)
  originality_attested_at DateTime  @default(now())
  moderation_reason       String?
  reviewed_by             String?
  reviewed_at             DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @default(now()) @updatedAt

  stats                   MemeStat?
  ratings                 MemeRating[]
  exposures               MemeExposure[]
  moderationActions       ModerationAction[]
  creatorBadges           CreatorBadge[]
  featuredMemes           FeaturedMeme[]
  shadowPredictions       MLShadowPrediction[]

  @@index([author_player_id])
  @@index([status])
  @@index([template_id])
  @@index([created_at])
  @@map("meme_submissions")
}

// ---------------------------------------------------------------------------
// 37. meme_ratings — post-drop Meme Corner ratings (Stage M3 / Phase 10G)
// ---------------------------------------------------------------------------
model MemeRating {
  id              String         @id @default(uuid())
  submission_id   String
  submission      MemeSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  rater_player_id String
  rater           Player         @relation(fields: [rater_player_id], references: [id], onDelete: Cascade)
  rating          String         @db.VarChar(20) // 'funny' | 'not_for_me'
  drop_date       DateTime       @db.Date
  created_at      DateTime       @default(now())

  @@unique([submission_id, rater_player_id], name: "submission_rater_unique")
  @@index([submission_id])
  @@index([rater_player_id])
  @@index([drop_date])
  @@map("meme_ratings")
}

// ---------------------------------------------------------------------------
// 38. meme_stats — aggregate rating counters and Wilson score lower bound (Stage M3 / Phase 10G)
// ---------------------------------------------------------------------------
model MemeStat {
  submission_id    String         @id
  submission       MemeSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  impressions      Int            @default(0)
  raters           Int            @default(0)
  funny_count      Int            @default(0)
  not_for_me_count Int            @default(0)
  wilson_lb        Float          @default(0.0)
  last_shown_at    DateTime?
  updated_at       DateTime       @default(now()) @updatedAt

  @@index([wilson_lb(sort: Desc)])
  @@map("meme_stats")
}

// ---------------------------------------------------------------------------
// 39. meme_exposures — impression tracking for diversity and exploration caps (Stage M3 / Phase 10G)
// ---------------------------------------------------------------------------
model MemeExposure {
  id            String         @id @default(uuid())
  submission_id String
  submission    MemeSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  player_id     String
  player        Player         @relation(fields: [player_id], references: [id], onDelete: Cascade)
  drop_date     DateTime       @db.Date
  shown_at      DateTime       @default(now())

  @@unique([submission_id, player_id, drop_date], name: "sub_player_drop_unique")
  @@index([player_id, drop_date])
  @@index([submission_id])
  @@map("meme_exposures")
}

// ---------------------------------------------------------------------------
// 40. moderation_actions — immutable audit log for moderation decisions (Stage M3 / Phase 10G)
// ---------------------------------------------------------------------------
model ModerationAction {
  id            String         @id @default(uuid())
  submission_id String
  submission    MemeSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  action        String         @db.VarChar(30) // 'approve' | 'reject' | 'retire' | 'takedown'
  reason        String
  note          String?
  admin_id      String
  created_at    DateTime       @default(now())

  @@index([submission_id])
  @@index([admin_id])
  @@index([created_at])
  @@map("moderation_actions")
}

// ---------------------------------------------------------------------------
// 41. player_taste — consented smoothed tag affinity scores (Stage M4 / Phase 10H)
// ---------------------------------------------------------------------------
model PlayerTaste {
  player_id       String
  player          Player   @relation(fields: [player_id], references: [id], onDelete: Cascade)
  tag_id          String
  tag             Tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  affinity_score  Float    @default(0.50)
  sample_size     Int      @default(0)
  last_engaged_at DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  @@id([player_id, tag_id])
  @@index([player_id])
  @@index([tag_id])
  @@index([affinity_score(sort: Desc)])
  @@map("player_taste")
}

// ---------------------------------------------------------------------------
// 42. notification_timing_stats — cohort-level aggregate send hour stats (Stage M4 / Phase 10H)
// ---------------------------------------------------------------------------
model NotificationTimingStat {
  id               String   @id @default(uuid())
  cohort_key       String   @db.VarChar(50)
  hour_of_day_utc  Int      @db.SmallInt
  open_rate        Float    @default(0.0)
  samples_count    Int      @default(0)
  updated_at       DateTime @default(now()) @updatedAt

  @@unique([cohort_key, hour_of_day_utc], name: "cohort_hour_unique")
  @@index([cohort_key])
  @@map("notification_timing_stats")
}

// ---------------------------------------------------------------------------
// 43. editor_suggestions — drop planning advisory & fatigue linting (Stage M4 / Phase 10H)
// ---------------------------------------------------------------------------
model EditorSuggestion {
  id               String   @id @default(uuid())
  target_drop_date DateTime @db.Date
  suggestion_type  String   @db.VarChar(50) // 'underused_tag' | 'high_share_weekend' | 'fatigue_warning'
  tag_id           String?
  tag              Tag?     @relation(fields: [tag_id], references: [id], onDelete: SetNull)
  severity         String   @default("info") @db.VarChar(20) // 'info' | 'warning' | 'critical'
  message          String
  dismissed        Boolean  @default(false)
  created_at       DateTime @default(now())

  @@index([target_drop_date])
  @@index([suggestion_type])
  @@index([severity])
  @@map("editor_suggestions")
}

// ---------------------------------------------------------------------------
// 44. badge_definitions — catalogue of creator recognition badges (Stage M5 & M6 / Phase 10I)
// ---------------------------------------------------------------------------
model BadgeDefinition {
  id               String         @id @default(uuid())
  key              String         @unique @db.VarChar(50)
  name_i18n        Json
  description_i18n Json
  icon_key         String         @db.VarChar(50)
  benchmark_config Json
  status           String         @default("active") @db.VarChar(20)
  created_at       DateTime       @default(now())

  creatorBadges    CreatorBadge[]

  @@index([key])
  @@index([status])
  @@map("badge_definitions")
}

// ---------------------------------------------------------------------------
// 45. creator_badges — player awarded recognition badges (Stage M5 & M6 / Phase 10I)
// ---------------------------------------------------------------------------
model CreatorBadge {
  id         String          @id @default(uuid())
  player_id  String
  player     Player          @relation(fields: [player_id], references: [id], onDelete: Cascade)
  badge_id   String
  badge      BadgeDefinition @relation(fields: [badge_id], references: [id], onDelete: Cascade)
  meme_id    String?
  meme       MemeSubmission? @relation(fields: [meme_id], references: [id], onDelete: SetNull)
  awarded_at DateTime        @default(now())

  @@unique([player_id, badge_id], name: "player_badge_unique")
  @@index([player_id])
  @@index([badge_id])
  @@index([meme_id])
  @@map("creator_badges")
}

// ---------------------------------------------------------------------------
// 46. featured_memes — curated Meme of the Week showcase (Stage M5 & M6 / Phase 10I)
// ---------------------------------------------------------------------------
model FeaturedMeme {
  id              String         @id @default(uuid())
  submission_id   String
  submission      MemeSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  week_start_date DateTime       @unique @db.Date
  curator_notes   String?
  published_at    DateTime       @default(now())

  @@index([week_start_date])
  @@index([submission_id])
  @@map("featured_memes")
}

// ---------------------------------------------------------------------------
// 47. ml_models — catalog of explainable ranker models (Stage M7 / Phase 10J)
// ---------------------------------------------------------------------------
model MLModel {
  id                   String               @id @default(uuid())
  version              String               @unique @db.VarChar(50)
  algorithm            String               @default("logistic_regression") @db.VarChar(50)
  weights              Json
  metrics              Json
  training_pairs_count Int                  @default(0)
  status               String               @default("shadow") @db.VarChar(20) // 'shadow' | 'active' | 'retired' | 'killed'
  trained_at           DateTime             @default(now())
  created_at           DateTime             @default(now())

  shadowPredictions    MLShadowPrediction[]

  @@index([status])
  @@index([version])
  @@map("ml_models")
}

// ---------------------------------------------------------------------------
// 48. ml_shadow_predictions — non-drop shadow inferences (Stage M7 / Phase 10J)
// ---------------------------------------------------------------------------
model MLShadowPrediction {
  id            String         @id @default(uuid())
  model_id      String
  model         MLModel        @relation(fields: [model_id], references: [id], onDelete: Cascade)
  submission_id String
  submission    MemeSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  wilson_lb     Float
  shadow_score  Float
  wilson_rank   Int
  shadow_rank   Int
  created_at    DateTime       @default(now())

  @@index([model_id])
  @@index([submission_id])
  @@index([created_at])
  @@map("ml_shadow_predictions")
}

// ---------------------------------------------------------------------------
// 49. plans — subscription plan catalogue (Stage M8 / Phase 10K)
// ---------------------------------------------------------------------------
model Plan {
  id               String        @id @default(uuid())
  key              String        @unique @db.VarChar(50)
  name_i18n        Json
  description_i18n Json
  price_inr_cents  Int           @default(7900)
  duration_days    Int           @default(30)
  status           String        @default("active") @db.VarChar(20) // 'active' | 'retired'
  created_at       DateTime      @default(now())

  entitlements     Entitlement[]
  subscriptions    Subscription[]

  @@index([key])
  @@index([status])
  @@map("plans")
}

// ---------------------------------------------------------------------------
// 50. entitlements — feature gates gated by plan (Stage M8 / Phase 10K)
// ---------------------------------------------------------------------------
model Entitlement {
  id          String   @id @default(uuid())
  plan_id     String
  plan        Plan     @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  feature_key String   @db.VarChar(50) // 'streak_freeze', 'historical_archive', 'bespoke_themes'
  config      Json     @default("{}")
  created_at  DateTime @default(now())

  @@unique([plan_id, feature_key], name: "plan_feature_unique")
  @@index([plan_id])
  @@index([feature_key])
  @@map("entitlements")
}

// ---------------------------------------------------------------------------
// 51. subscriptions — player subscription records (Stage M8 / Phase 10K)
// ---------------------------------------------------------------------------
model Subscription {
  id                       String    @id @default(uuid())
  player_id                String
  player                   Player    @relation(fields: [player_id], references: [id], onDelete: Cascade)
  plan_id                  String
  plan                     Plan      @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  status                   String    @default("active") @db.VarChar(20) // 'active' | 'cancelled' | 'expired' | 'past_due'
  started_at               DateTime  @default(now())
  current_period_end       DateTime
  cancelled_at             DateTime?
  provider                 String    @default("mock") @db.VarChar(30)
  provider_subscription_id String?   @db.VarChar(100)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @default(now()) @updatedAt

  @@index([player_id])
  @@index([status])
  @@index([current_period_end])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// 52. paywall_events — impressions & dismissals for frequency capping (Stage M8 / Phase 10K)
// ---------------------------------------------------------------------------
model PaywallEvent {
  id         String   @id @default(uuid())
  player_id  String
  player     Player   @relation(fields: [player_id], references: [id], onDelete: Cascade)
  surface    String   @db.VarChar(50) // 'me_settings', 'archive_view', 'recap_perks'
  event_type String   @db.VarChar(20) // 'offer_shown', 'dismissed', 'converted'
  created_at DateTime @default(now())

  @@index([player_id])
  @@index([event_type])
  @@index([created_at])
  @@map("paywall_events")
}

// ---------------------------------------------------------------------------
// 53. lanes — subject drop catalog & configuration (Stage L1 / Phase 10L)
// ---------------------------------------------------------------------------
model Lane {
  id                 String    @id @default(uuid())
  slug               String    @unique @db.VarChar(50)
  name_key           String    @db.VarChar(100)
  description_key    String    @db.VarChar(150)
  accent_token       String    @db.VarChar(50)
  icon_key           String    @db.VarChar(50)
  status             String    @default("planned") @db.VarChar(20) // 'planned', 'preview', 'open', 'resting', 'retired'
  sort_order         Int       @default(100)
  age_rating         String    @default("18+") @db.VarChar(10)
  locale_set         Json      @default("[\"en\", \"hi\"]")
  formats_allowed    Json      @default("[\"pick1\", \"pick2of6\", \"slider7\"]")
  text_enabled       Boolean   @default(false)
  super_twin_enabled Boolean   @default(true)
  gate_notes         String?   @db.Text
  opened_at          DateTime?
  created_at         DateTime  @default(now())

  drops           Drop[]
  questions       Question[]
  laneInterests   LaneInterest[]
  playerLanePrefs PlayerLanePref[]
  oddnessScores   OddnessScore[]
  antiTwinResults AntiTwinResult[]
  laneHistorySignatures LaneHistorySignature[]

  @@index([status])
  @@index([slug])
  @@index([sort_order])
  @@map("lanes")
}

// ---------------------------------------------------------------------------
// 54. lane_interest — opt-ins for planned lanes ("Tell me when it opens") (Stage L1 / Phase 10L)
// ---------------------------------------------------------------------------
model LaneInterest {
  id         String   @id @default(uuid())
  lane_id    String
  lane       Lane     @relation(fields: [lane_id], references: [id], onDelete: Cascade)
  player_id  String?
  player     Player?  @relation(fields: [player_id], references: [id], onDelete: Cascade)
  guest_id   String?  @db.VarChar(100)
  created_at DateTime @default(now())

  @@unique([lane_id, player_id])
  @@index([lane_id])
  @@index([lane_id, guest_id])
  @@map("lane_interest")
}

// ---------------------------------------------------------------------------
// 55. player_lane_prefs — per-lane notification and history toggles (Stage L1 / Phase 10L)
// ---------------------------------------------------------------------------
model PlayerLanePref {
  id             String    @id @default(uuid())
  player_id      String
  player         Player    @relation(fields: [player_id], references: [id], onDelete: Cascade)
  lane_id        String
  lane           Lane      @relation(fields: [lane_id], references: [id], onDelete: Cascade)
  notify         Boolean   @default(false)
  last_played_at DateTime?
  plays_count    Int       @default(0)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt

  @@unique([player_id, lane_id])
  @@index([player_id])
  @@index([lane_id])
  @@map("player_lane_prefs")
}

// ---------------------------------------------------------------------------
// 56. lane_history_signatures — compact 32-byte BitMinHash signatures (Stage L3 / Phase 10N / ADR-047)
// ---------------------------------------------------------------------------
model LaneHistorySignature {
  id          String   @id @default(uuid())
  player_id   String
  lane_id     String
  signature   Bytes    // 32 bytes (256 bits)
  days_active Int      @default(0)
  updated_at  DateTime @default(now())

  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)
  lane   Lane   @relation(fields: [lane_id], references: [id], onDelete: Cascade)

  @@unique([player_id, lane_id])
  @@index([player_id])
  @@index([lane_id])
  @@map("lane_history_signatures")
}

// ---------------------------------------------------------------------------
// 58. blocks — mutual safety exclusion
// ---------------------------------------------------------------------------
model Block {
  id         String   @id @default(uuid())
  blocker_id String
  blocker    Player   @relation("Blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked_id String
  blocked    Player   @relation("Blocked", fields: [blocked_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([blocker_id, blocked_id])
  @@index([blocker_id])
  @@index([blocked_id])
  @@map("blocks")
}

// ---------------------------------------------------------------------------
// 59. globe_arcs — coarse time-bucketed twin formation paths
// ---------------------------------------------------------------------------
model GlobeArc {
  id           String   @id @default(uuid())
  lane_id      String?
  region_a     String   @db.VarChar(10)
  region_b     String   @db.VarChar(10)
  bucket_time  DateTime
  count        Int      @default(1)
  is_synthetic Boolean? @default(false)
  created_at   DateTime @default(now())

  @@index([bucket_time])
  @@index([lane_id, bucket_time])
  @@map("globe_arcs")
}

// ---------------------------------------------------------------------------
// 60. orbit_subject_sync — tag-level agreement rate stats (Stage F28)
// ---------------------------------------------------------------------------
model OrbitSubjectSync {
  id         String   @id @default(uuid())
  orbit_id   String
  orbit      Orbit    @relation(fields: [orbit_id], references: [id], onDelete: Cascade)
  tag_slug   String   @db.VarChar(50)
  agreed     Int      @default(0)
  total      Int      @default(0)
  updated_at DateTime @default(now()) @updatedAt

  @@unique([orbit_id, tag_slug])
  @@index([orbit_id])
  @@map("orbit_subject_sync")
}

// ---------------------------------------------------------------------------
// 61. trial_prompts — 2-option neutral lifestyle prompt bank for Duo Trial
// ---------------------------------------------------------------------------
model TrialPrompt {
  id          String   @id @default(uuid())
  prompt_text String   @db.VarChar(300)
  option_a    String   @db.VarChar(100)
  option_b    String   @db.VarChar(100)
  category    String   @default("lifestyle") @db.VarChar(50)
  created_at  DateTime @default(now())

  @@map("trial_prompts")
}

// ---------------------------------------------------------------------------
// 62. orbit_trials — Duo Trial v0 attempt records (Door 1 of Chat Unlock)
// ---------------------------------------------------------------------------
model OrbitTrial {
  id             String             @id @default(uuid())
  orbit_id       String
  orbit          Orbit              @relation(fields: [orbit_id], references: [id], onDelete: Cascade)
  attempt_number Int                @default(1)
  started_by     String
  started_at     DateTime           @default(now())
  window_ends_at DateTime
  status         String             @default("pending") @db.VarChar(20) // pending | completed | expired
  score          Int?
  passed         Boolean?
  pass_mark      Int                @default(5)
  answers        OrbitTrialAnswer[]

  @@unique([orbit_id, attempt_number])
  @@index([orbit_id])
  @@map("orbit_trials")
}

// ---------------------------------------------------------------------------
// 63. orbit_trial_answers — detailed picks during 24h trial attempt window
// ---------------------------------------------------------------------------
model OrbitTrialAnswer {
  id         String     @id @default(uuid())
  trial_id   String
  trial      OrbitTrial @relation(fields: [trial_id], references: [id], onDelete: Cascade)
  player_id  String
  prompt_id  String
  choice     String     @db.VarChar(50)
  created_at DateTime   @default(now())

  @@unique([trial_id, player_id, prompt_id])
  @@index([trial_id])
  @@map("orbit_trial_answers")
}

// ---------------------------------------------------------------------------
// 64. bonus_rounds — Additive tie group bonus competition (Stage L9 / Slice B1)
// ---------------------------------------------------------------------------
model BonusRound {
  id             String             @id @default(uuid())
  drop_id        String
  lane_id        String
  round_number   Int                @default(1)
  tie_group_hash String             @db.VarChar(64)
  question_ids   Json               // array of 3 question ids
  status         String             @default("open") @db.VarChar(20) // open | closed
  created_at     DateTime           @default(now())
  closes_at      DateTime
  participants   BonusParticipant[]
  answers        BonusAnswer[]
  results        BonusResult[]

  @@unique([drop_id, tie_group_hash, round_number])
  @@index([drop_id])
  @@map("bonus_rounds")
}

model BonusParticipant {
  id        String     @id @default(uuid())
  round_id  String
  round     BonusRound @relation(fields: [round_id], references: [id], onDelete: Cascade)
  player_id String
  joined_at DateTime   @default(now())

  @@unique([round_id, player_id])
  @@index([round_id])
  @@map("bonus_participants")
}

model BonusAnswer {
  id           String     @id @default(uuid())
  round_id     String
  round        BonusRound @relation(fields: [round_id], references: [id], onDelete: Cascade)
  player_id    String
  answers      Json
  submitted_at DateTime   @default(now())

  @@unique([round_id, player_id])
  @@index([round_id])
  @@map("bonus_answers")
}

model BonusResult {
  id               String     @id @default(uuid())
  round_id         String
  round            BonusRound @relation(fields: [round_id], references: [id], onDelete: Cascade)
  player_id        String
  closest_peer_id  String?
  similarity_score Float      @default(0)
  bonus_matches    Int        @default(0)
  created_at       DateTime   @default(now())

  @@unique([round_id, player_id])
  @@index([round_id])
  @@map("bonus_results")
}

// ---------------------------------------------------------------------------
// 65. collector_badges — non-evaluative collector badges (Stage L10 / Slice B3)
// ---------------------------------------------------------------------------
model CollectorBadgeDefinition {
  id          String           @id // e.g. "collector_tier1", "all_lanes", "super_twin"
  name        String           @db.VarChar(100)
  description String           @db.VarChar(300)
  icon_key    String           @db.VarChar(50)
  created_at  DateTime         @default(now())
  badges      CollectorBadge[]

  @@map("collector_badge_definitions")
}

model CollectorBadge {
  id            String                   @id @default(uuid())
  player_id     String
  player        Player                   @relation(fields: [player_id], references: [id], onDelete: Cascade)
  definition_id String
  definition    CollectorBadgeDefinition @relation(fields: [definition_id], references: [id])
  evidence_data Json?                    // references to twin results / lanes
  is_shared     Boolean                  @default(false)
  share_id      String?                  @unique @db.VarChar(64)
  awarded_at    DateTime                 @default(now())
  revoked_at    DateTime?

  @@unique([player_id, definition_id])
  @@index([player_id])
  @@map("collector_badges")
}

// ---------------------------------------------------------------------------
// 66. audit_logs — immutable ops and moderation audit log
// ---------------------------------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  action      String   @db.VarChar(50) // sever_orbit, ban_player, pull_question, disable_feature
  target_type String   @db.VarChar(50)
  target_id   String   @db.VarChar(128)
  actor       String   @default("system") @db.VarChar(50)
  before_data Json?
  after_data  Json?
  created_at  DateTime @default(now())

  @@index([action])
  @@index([target_type, target_id])
  @@map("audit_logs")
}





