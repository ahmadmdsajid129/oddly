// Oddly v1 — Prisma Schema
// packages/shared/prisma/schema.prisma
// All 18 tables. Everything dynamic comes from the DB.
// D-005: No hardcoded questions/copy/config in code.

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum DropStatus {
  pending
  live
  closed
}

enum QuestionType {
  text
  number
  colour
  image
  word
}

enum ShareFormat {
  story
  square
  link
}

enum TierEnum {
  Common
  Uncommon
  Rare
  Mythic
}

enum ReportReason {
  offensive
  spam
  incorrect
  other
}

enum KeepStatus {
  pending
  accepted
  declined
  expired
}

enum OrbitStatus {
  active
  ended
}

// ---------------------------------------------------------------------------
// 1. accounts — optional Google-linked account (may be null for guest players)
// ---------------------------------------------------------------------------
model Account {
  id           String    @id @default(uuid())
  google_sub   String    @unique
  email_hash   String    // SHA-256 of email, never store plaintext
  display_name String    @db.VarChar(50)
  created_at   DateTime  @default(now())
  deleted_at   DateTime?

  players Player[]

  @@map("accounts")
}

// ---------------------------------------------------------------------------
// 2. players — a device (guest). May be linked to an Account.
// ---------------------------------------------------------------------------
model Player {
  id              String    @id @default(uuid())
  did             String    @unique @db.VarChar(128) // device fingerprint
  account_id      String?
  account         Account?  @relation(fields: [account_id], references: [id])
  region          String    @db.VarChar(10)   // ISO 3166-1 alpha-2 (e.g. "IN")
  age_band        String    @db.VarChar(10)   // "18-24", "25-34", etc.
  push_token_enc  String?   @db.Text          // AES-256-GCM encrypted push token
  created_at      DateTime  @default(now())

  submissions      Submission[]
  streakLogs       StreakLog[]
  pushSubscriptions PushSubscription[]
  matchesAsA       Match[]  @relation("PlayerA")
  matchesAsB       Match[]  @relation("PlayerB")
  reports          Report[]
  keepsSent        TwinKeep[] @relation("KeepFrom")
  keepsReceived    TwinKeep[] @relation("KeepTo")
  orbitsAsA        Orbit[]    @relation("OrbitPlayerA")
  orbitsAsB        Orbit[]    @relation("OrbitPlayerB")
  orbitExpressions OrbitExpression[]
  telepathyGuesses TelepathyGuess[]
  antiTwinResults  AntiTwinResult[]
  consents         Consent[]
  analyticsId      AnalyticsId?

  @@index([account_id])
  @@index([did])
  @@map("players")
}

// ---------------------------------------------------------------------------
// 3. drops — one per day (07:00 IST open, 23:59 IST close)
// ---------------------------------------------------------------------------
model Drop {
  id                    String     @id @default(uuid())
  drop_date             DateTime   @db.Date @unique // YYYY-MM-DD in IST
  opens_at              DateTime                    // UTC timestamp for 07:00 IST
  closes_at             DateTime                    // UTC timestamp for 23:59 IST
  status                DropStatus @default(pending)
  telepathy_question_id String?
  telepathy_question    Question?  @relation("DropTelepathyQuestion", fields: [telepathy_question_id], references: [id])
  theme_key             String?    @db.VarChar(50)
  created_at            DateTime   @default(now())

  questions    Question[]
  submissions  Submission[]
  matches      Match[]
  streakLogs   StreakLog[]
  reports      Report[]
  batchRuns    BatchRun[]

  @@index([drop_date])
  @@index([status])
  @@index([telepathy_question_id])
  @@index([theme_key])
  @@map("drops")
}

// ---------------------------------------------------------------------------
// 4. questions — 5 per drop, polymorphic via JSONB payload
// ---------------------------------------------------------------------------
model Question {
  id         String       @id @default(uuid())
  drop_id    String
  drop       Drop         @relation(fields: [drop_id], references: [id])
  position       Int          @db.SmallInt // 1-5
  type           QuestionType
  render_variant String       @default("standard") @db.VarChar(20) // "standard" | "meme"
  template_id    String?
  memeTemplate   MemeTemplate? @relation(fields: [template_id], references: [id])
  payload        Json         // discriminated by type (see D-006)
  created_at     DateTime     @default(now())

  answerOptions      AnswerOption[]
  telepathyForDrops  Drop[]            @relation("DropTelepathyQuestion")
  telepathyGuesses   TelepathyGuess[]
  questionTags       QuestionTag[]
  statsDaily         QuestionStatsDaily[]

  @@unique([drop_id, position])
  @@index([drop_id])
  @@index([render_variant])
  @@index([template_id])
  @@map("questions")
}

// ---------------------------------------------------------------------------
// 5. answer_options — static choices for a question
// ---------------------------------------------------------------------------
model AnswerOption {
  id               String   @id @default(uuid())
  question_id      String
  question         Question @relation(fields: [question_id], references: [id])
  label            String   @db.VarChar(200)
  value            String   @db.VarChar(200) // canonical value used in matching
  display_order    Int      @db.SmallInt
  illustration_key String?  @db.VarChar(100) // links to SVG registry (Q-Type 4)

  @@index([question_id])
  @@map("answer_options")
}

// ---------------------------------------------------------------------------
// 6. submissions — range-partitioned by drop_date (R2.1)
// ---------------------------------------------------------------------------
model Submission {
  id           String   @default(uuid())
  drop_id      String
  drop_date    DateTime @db.Date
  drop         Drop     @relation(fields: [drop_id], references: [id])
  player_id    String
  player       Player   @relation(fields: [player_id], references: [id])
  request_id   String   @db.VarChar(64) // client-generated idempotency key
  answers      Json     // array of {question_id, value} — matches AnswerPayload[]
  submitted_at DateTime @default(now())
  is_bot_flagged Boolean @default(false)

  oddnessScore      OddnessScore?
  shareCards        ShareCard[]
  submissionAnswers SubmissionAnswer[]

  @@id([id, drop_date])
  @@unique([drop_date, request_id])
  @@unique([drop_date, player_id])
  @@index([drop_date])
  @@index([drop_id])
  @@index([player_id])
  @@index([submitted_at])
  @@map("submissions")
}

// ---------------------------------------------------------------------------
// 6b. submission_answers — normalized answers partitioned by drop_date (R2.1)
// ---------------------------------------------------------------------------
model SubmissionAnswer {
  id            String     @default(uuid())
  submission_id String
  drop_id       String
  drop_date     DateTime   @db.Date
  player_id     String
  question_id   String
  value         String     @db.VarChar(200)
  created_at    DateTime   @default(now())

  submission    Submission @relation(fields: [submission_id, drop_date], references: [id, drop_date])

  @@id([id, drop_date])
  @@index([drop_date, question_id, value])
  @@index([drop_date, player_id])
  @@map("submission_answers")
}

// ---------------------------------------------------------------------------
// 7. answer_stats — running probability per question value partitioned by drop_date (R2.1)
// ---------------------------------------------------------------------------
model AnswerStat {
  id          String   @default(uuid())
  drop_id     String
  drop_date   DateTime @db.Date
  question_id String
  value       String   @db.VarChar(200)
  count       Int      @default(0)
  probability Float    @default(0) // count / total_submissions_for_drop
  updated_at  DateTime @default(now())

  @@id([id, drop_date])
  @@unique([drop_date, question_id, value])
  @@index([drop_date])
  @@index([question_id])
  @@map("answer_stats")
}

// ---------------------------------------------------------------------------
// 8. matches — pairwise match for a drop partitioned by drop_date (R2.1)
// ---------------------------------------------------------------------------
model Match {
  id               String    @default(uuid())
  drop_id          String
  drop_date        DateTime  @db.Date
  drop             Drop      @relation(fields: [drop_id], references: [id])
  player_a_id      String
  player_a         Player    @relation("PlayerA", fields: [player_a_id], references: [id])
  player_b_id      String
  player_b         Player    @relation("PlayerB", fields: [player_b_id], references: [id])
  submission_a_id  String?
  submission_b_id  String?
  similarity_score Float     // dice coefficient [0, 1]
  is_provisional   Boolean   @default(true)  // true until drop closes
  matched_at       DateTime  @default(now())
  finalized_at     DateTime?

  @@id([id, drop_date])
  @@unique([drop_date, player_a_id])
  @@unique([drop_date, player_b_id])
  @@index([drop_date])
  @@index([drop_id])
  @@index([player_a_id])
  @@index([player_b_id])
  @@map("matches")
}

// ---------------------------------------------------------------------------
// 9. oddness_scores — computed after drop closes
// ---------------------------------------------------------------------------
model OddnessScore {
  id            String     @id @default(uuid())
  submission_id String
  drop_date     DateTime   @db.Date
  submission    Submission @relation(fields: [submission_id, drop_date], references: [id, drop_date])
  raw_score     Float      // weighted entropy [0, 1]
  percentile    Float      // 0-100 within day's cohort
  tier          TierEnum

  @@unique([submission_id, drop_date])
  @@index([submission_id])
  @@index([tier])
  @@map("oddness_scores")
}

// ---------------------------------------------------------------------------
// 10. streak_logs — one row per player per drop they participated in
// ---------------------------------------------------------------------------
model StreakLog {
  id             String   @id @default(uuid())
  player_id      String
  player         Player   @relation(fields: [player_id], references: [id])
  drop_id        String
  drop           Drop     @relation(fields: [drop_id], references: [id])
  streak_count   Int      @default(1)
  calculated_at  DateTime @default(now())

  @@unique([player_id, drop_id])
  @@index([player_id])
  @@map("streak_logs")
}

// ---------------------------------------------------------------------------
// 11. share_cards — generated PNG/story/square card per submission
// ---------------------------------------------------------------------------
model ShareCard {
  id            String      @id @default(uuid())
  submission_id String
  drop_date     DateTime    @db.Date
  submission    Submission  @relation(fields: [submission_id, drop_date], references: [id, drop_date])
  format        ShareFormat
  storage_key   String      @db.Text // S3/R2 object key
  generated_at  DateTime    @default(now())

  @@unique([submission_id, format])
  @@index([submission_id])
  @@map("share_cards")
}

// ---------------------------------------------------------------------------
// 12. short_links — 6-char slug for share URLs
// ---------------------------------------------------------------------------
model ShortLink {
  id            String     @id @default(uuid())
  short_id      String     @unique @db.VarChar(8) // e.g. "xK9mP2"
  submission_id String
  created_at    DateTime   @default(now())
  views         Int        @default(0)

  @@index([short_id])
  @@map("short_links")
}

// ---------------------------------------------------------------------------
// 13. push_subscriptions — Web Push subscription endpoint + keys
// ---------------------------------------------------------------------------
model PushSubscription {
  id         String   @id @default(uuid())
  player_id  String
  player     Player   @relation(fields: [player_id], references: [id])
  endpoint   String   @db.Text
  keys       Json     // { p256dh: string, auth: string }
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@unique([player_id, endpoint])
  @@index([player_id])
  @@index([is_active])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// 14. app_content — all UI strings, by locale key (D-005)
// ---------------------------------------------------------------------------
model AppContent {
  id         String   @id @default(uuid())
  key        String   @db.VarChar(200)
  locale     String   @db.VarChar(10) @default("en")
  value      String   @db.Text
  updated_at DateTime @updatedAt

  @@unique([key, locale])
  @@index([key])
  @@map("app_content")
}

// ---------------------------------------------------------------------------
// 15. app_config — feature flags and runtime settings (D-005)
// ---------------------------------------------------------------------------
model AppConfig {
  id         String   @id @default(uuid())
  key        String   @unique @db.VarChar(200)
  value      Json     // any JSON value
  updated_at DateTime @updatedAt

  @@map("app_config")
}

// ---------------------------------------------------------------------------
// 16. tier_definitions — dynamic tier thresholds (D-005)
// ---------------------------------------------------------------------------
model TierDefinition {
  id              String   @id @default(uuid())
  tier            TierEnum @unique
  min_percentile  Float
  max_percentile  Float
  label           String   @db.VarChar(50)
  description     String   @db.Text
  badge_color     String   @db.VarChar(20) // hex or CSS colour token

  @@map("tier_definitions")
}

// ---------------------------------------------------------------------------
// 17. pages — CMS-managed static pages (About, Privacy, FAQ)
// ---------------------------------------------------------------------------
model Page {
  id         String   @id @default(uuid())
  slug       String   @unique @db.VarChar(100)
  title      String   @db.VarChar(200)
  body_md    String   @db.Text
  updated_at DateTime @updatedAt

  @@map("pages")
}

// ---------------------------------------------------------------------------
// 18. reports — player reporting another submission
// ---------------------------------------------------------------------------
model Report {
  id          String       @id @default(uuid())
  reporter_id String
  reporter    Player       @relation(fields: [reporter_id], references: [id])
  drop_id     String
  drop        Drop         @relation(fields: [drop_id], references: [id])
  submission_id String
  reason      ReportReason
  note        String?      @db.Text
  created_at  DateTime     @default(now())

  @@index([drop_id])
  @@index([reporter_id])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// 19. batch_runs — chunked resumable final batch progress tracking (R1.1)
// ---------------------------------------------------------------------------
model BatchRun {
  id           String    @id @default(uuid())
  drop_id      String
  drop         Drop      @relation(fields: [drop_id], references: [id])
  chunk_index  Int
  cursor_from  String?   @db.VarChar(128)
  cursor_to    String?   @db.VarChar(128)
  player_count Int       @default(0)
  status       String    @db.VarChar(20) // pending | processing | completed | failed
  attempts     Int       @default(0)
  started_at   DateTime?
  completed_at DateTime?
  error        String?   @db.Text
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@unique([drop_id, chunk_index])
  @@index([drop_id, status])
  @@map("batch_runs")
}

// ---------------------------------------------------------------------------
// 20. scheduler_runs — idempotent leader tracking for daily crons (R1.1)
// ---------------------------------------------------------------------------
model SchedulerRun {
  id           String    @id @default(uuid())
  job_name     String    @db.VarChar(100) // stageDrop | openDrop | closeDrop | matchFinal
  run_for      String    @db.VarChar(100) // drop_date (e.g. "2026-11-10") or drop_id
  status       String    @db.VarChar(20)  // running | completed | failed
  started_at   DateTime  @default(now())
  completed_at DateTime?
  error        String?   @db.Text

  @@unique([job_name, run_for])
  @@index([job_name, run_for, status])
  @@map("scheduler_runs")
}

// ---------------------------------------------------------------------------
// 21. user_history_summaries — compacted daily player summaries for 90-day retention (R2.1)
// ---------------------------------------------------------------------------
model UserHistorySummary {
  id               String   @id @default(uuid())
  player_id        String
  account_id       String?
  drop_id          String
  drop_date        DateTime @db.Date
  similarity_score Float
  oddness_score    Float
  percentile       Float
  tier             String   @db.VarChar(32)
  twin_player_id   String?
  twin_region      String?  @db.VarChar(10)
  summary_json     Json
  created_at       DateTime @default(now())

  @@unique([player_id, drop_date])
  @@index([player_id])
  @@index([drop_date])
  @@map("user_history_summaries")
}

// ---------------------------------------------------------------------------
// 22. partition_alerts — records any fallback rows caught by DEFAULT partition (R2.1)
// ---------------------------------------------------------------------------
model PartitionAlert {
  id            String   @id @default(uuid())
  table_name    String
  drop_date     DateTime @db.Date
  row_id        String
  alert_message String
  created_at    DateTime @default(now())

  @@map("partition_alerts")
}

// ---------------------------------------------------------------------------
// 23. twin_keeps — private symmetric requests to establish an Orbit (Stage F1 / Phase 10A)
// Range-partitioned by drop_date
// ---------------------------------------------------------------------------
model TwinKeep {
  id                  String     @default(uuid())
  drop_date           DateTime   @db.Date
  from_player_id      String
  from_player         Player     @relation("KeepFrom", fields: [from_player_id], references: [id])
  to_player_id        String
  to_player           Player     @relation("KeepTo", fields: [to_player_id], references: [id])
  status              KeepStatus @default(pending)
  similarity_snapshot Float
  created_at          DateTime   @default(now())
  decided_at          DateTime?

  @@id([id, drop_date])
  @@unique([drop_date, from_player_id])
  @@index([drop_date])
  @@index([to_player_id, status])
  @@index([from_player_id, drop_date])
  @@map("twin_keeps")
}

// ---------------------------------------------------------------------------
// 24. orbits — mutual long-running relationship between two players (Stage F1 / Phase 10A)
// Invariant: player_a_id < player_b_id (lexicographical sorting)
// ---------------------------------------------------------------------------
model Orbit {
  id                String      @id @default(uuid())
  player_a_id       String
  player_a          Player      @relation("OrbitPlayerA", fields: [player_a_id], references: [id])
  player_b_id       String
  player_b          Player      @relation("OrbitPlayerB", fields: [player_b_id], references: [id])
  status            OrbitStatus @default(active)
  started_on        DateTime    @db.Date
  ended_on          DateTime?   @db.Date
  co_streak_current Int         @default(0)
  co_streak_best    Int         @default(0)
  last_co_date      DateTime?   @db.Date
  ended_by          String?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @default(now()) @updatedAt

  expressions       OrbitExpression[]
  telepathyGuesses  TelepathyGuess[]

  @@index([player_a_id, status])
  @@index([player_b_id, status])
  @@map("orbits")
}

// ---------------------------------------------------------------------------
// 25. orbit_expressions — lightweight daily one-tap non-verbal sticker interactions (The Wave)
// Range-partitioned by drop_date
// ---------------------------------------------------------------------------
model OrbitExpression {
  id             String   @default(uuid())
  orbit_id       String
  orbit          Orbit    @relation(fields: [orbit_id], references: [id])
  from_player_id String
  from_player    Player   @relation(fields: [from_player_id], references: [id])
  drop_date      DateTime @db.Date
  expression_key String   @db.VarChar(50)
  created_at     DateTime @default(now())

  @@id([id, drop_date])
  @@unique([orbit_id, from_player_id, drop_date])
  @@index([orbit_id, drop_date])
  @@map("orbit_expressions")
}

// ---------------------------------------------------------------------------
// 26. telepathy_guesses — daily instinct guessing inside Orbits (Stage F3 / Phase 10C)
// Range-partitioned by drop_date, 90-day retention
// ---------------------------------------------------------------------------
model TelepathyGuess {
  id                 String   @default(uuid())
  orbit_id           String
  orbit              Orbit    @relation(fields: [orbit_id], references: [id], onDelete: Cascade)
  drop_date          DateTime @db.Date
  guesser_player_id  String
  guesser_player     Player   @relation(fields: [guesser_player_id], references: [id], onDelete: Cascade)
  question_id        String
  question           Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  guessed_option_key String
  partner_option_key String?
  hit                Boolean?
  baseline_p         Float    @default(0.25)
  created_at         DateTime @default(now())

  @@id([id, drop_date])
  @@unique([orbit_id, drop_date, guesser_player_id])
  @@index([drop_date])
  @@index([orbit_id, drop_date])
  @@index([guesser_player_id, drop_date])
  @@map("telepathy_guesses")
}

// ---------------------------------------------------------------------------
// 27. anti_twin_results — asynchronously computed opposite match per user (Stage F4 / Phase 10D)
// 7-day rolling retention, zero opposite pick exposure
// ---------------------------------------------------------------------------
model AntiTwinResult {
  drop_date               DateTime @db.Date
  player_id               String
  player                  Player   @relation(fields: [player_id], references: [id], onDelete: Cascade)
  opposite_submission_ref String
  differed_count          Int
  sample_size             Int
  computed_at             DateTime @default(now())

  @@id([drop_date, player_id])
  @@index([drop_date])
  @@index([player_id])
  @@map("anti_twin_results")
}

// ---------------------------------------------------------------------------
// 28. tags — neutral subject taxonomy (Stage M1 / Phase 10E / F24)
// ---------------------------------------------------------------------------
model Tag {
  id         String   @id @default(uuid())
  key        String   @unique @db.VarChar(50)
  label_i18n Json     // localized labels { en: "Humour", ... }
  category   String   @db.VarChar(30)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  questionTags QuestionTag[]
  statsDaily   TagStatsDaily[]

  @@index([key])
  @@index([category])
  @@map("tags")
}

// ---------------------------------------------------------------------------
// 29. question_tags — many-to-many link between questions and subject tags (Stage M1 / Phase 10E)
// ---------------------------------------------------------------------------
model QuestionTag {
  question_id String
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  tag_id      String
  tag         Tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())

  @@id([question_id, tag_id])
  @@index([question_id])
  @@index([tag_id])
  @@map("question_tags")
}

// ---------------------------------------------------------------------------
// 30. meme_templates — curated vector SVG illustration templates (Stage M1 / Phase 10E / F24)
// ---------------------------------------------------------------------------
model MemeTemplate {
  id                        String   @id @default(uuid())
  key                       String   @unique
  illustration_registry_key String
  aspect                    String   @default("1:1")
  alt_text_i18n             Json
  license_note              String
  status                    String   @default("active") @db.VarChar(20)
  created_at                DateTime @default(now())

  questions Question[]

  @@index([key])
  @@index([status])
  @@map("meme_templates")
}

// ---------------------------------------------------------------------------
// 31. consents — granular, withdrawable DPDP consent records (Stage M2 / Phase 10F)
// ---------------------------------------------------------------------------
model Consent {
  id             String    @id @default(uuid())
  player_id      String
  player         Player    @relation(fields: [player_id], references: [id], onDelete: Cascade)
  purpose        String    @db.VarChar(30) // 'analytics' | 'personalisation'
  policy_version Int       @default(1)
  granted_at     DateTime  @default(now())
  withdrawn_at   DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt

  @@unique([player_id, purpose], name: "player_purpose")
  @@index([player_id])
  @@index([purpose])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// 32. analytics_ids — 1:1 pseudonymous identity severance table (Stage M2 / Phase 10F)
// ---------------------------------------------------------------------------
model AnalyticsId {
  player_id    String   @id
  player       Player   @relation(fields: [player_id], references: [id], onDelete: Cascade)
  analytics_id String   @unique @default(uuid())
  created_at   DateTime @default(now())

  @@index([analytics_id])
  @@map("analytics_ids")
}

// ---------------------------------------------------------------------------
// 33. events_raw — high-throughput, consented telemetry events (Stage M2 / Phase 10F)
// Range-partitioned by drop_date, 90-day retention
// ---------------------------------------------------------------------------
model EventRaw {
  id           String   @default(uuid())
  analytics_id String
  drop_date    DateTime @db.Date
  event_name   String   @db.VarChar(50)
  props        Json     @default("{}")
  session_id   String?  @db.VarChar(64)
  created_at   DateTime @default(now())

  @@id([drop_date, id])
  @@index([analytics_id])
  @@index([event_name])
  @@map("events_raw")
}

// ---------------------------------------------------------------------------
// 34. question_stats_daily — nightly aggregated question quality metrics (Stage M2 / Phase 10F)
// ---------------------------------------------------------------------------
model QuestionStatsDaily {
  drop_date      DateTime @db.Date
  question_id    String
  question       Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  shown_count    Int      @default(0)
  answered_count Int      @default(0)
  dwell_p50_ms   Int      @default(0)
  dwell_p90_ms   Int      @default(0)
  change_rate    Float    @default(0.0)
  back_rate      Float    @default(0.0)
  abandon_rate   Float    @default(0.0)
  report_rate    Float    @default(0.0)
  entropy        Float    @default(0.0)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  @@id([drop_date, question_id])
  @@index([question_id])
  @@map("question_stats_daily")
}

// ---------------------------------------------------------------------------
// 35. tag_stats_daily — nightly aggregated performance by subject tag (Stage M2 / Phase 10F)
// ---------------------------------------------------------------------------
model TagStatsDaily {
  drop_date    DateTime @db.Date
  tag_id       String
  tag          Tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  completions  Int      @default(0)
  share_count  Int      @default(0)
  dwell_p50_ms Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@id([drop_date, tag_id])
  @@index([tag_id])
  @@map("tag_stats_daily")
}





