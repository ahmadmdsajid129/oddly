# ==============================================================================
# Oddly v1 — Master Environment Configuration Template (.env.example)
# Copy to .env and configure real local/staging secrets.
# ==============================================================================

# Core Runtime
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# Persistence & Queues
DATABASE_URL=postgresql://oddly:oddlypass@localhost:5432/oddly?schema=public
REDIS_URL=redis://localhost:6379

# Authentication & Session Security (Min 32 characters random strings)
JWT_ACCESS_SECRET=development_jwt_access_secret_min_32_characters_long_12345
JWT_REFRESH_SECRET=development_jwt_refresh_secret_min_32_characters_long_12345
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Third-Party Identity (Google Sign-In)
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret

# Bot Defense (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Web Push Notification Gateway (VAPID)
VAPID_PUBLIC_KEY=mock-vapid-public-key
VAPID_PRIVATE_KEY=mock-vapid-private-key
VAPID_SUBJECT=mailto:security@oddly.app

# Object Storage (Cloudflare R2 / S3 Compatible)
R2_ACCOUNT_ID=mock-cloudflare-account-id
R2_ACCESS_KEY_ID=mock-r2-access-key-id
R2_SECRET_ACCESS_KEY=mock-r2-secret-access-key
R2_BUCKET=oddly-share-cards
R2_PUBLIC_BASE_URL=http://localhost:3000/cards

# Observability, Crash Tracing & Analytics
POSTHOG_KEY=phc_mock_posthog_project_key
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=https://mock@sentry.io/1234567

# Internal Admin & Operations
ADMIN_EMAIL_ALLOWLIST=founder@oddly.app,admin@oddly.app
DROP_START_TIME_IST=07:00
CLOCK_ACCELERATION=false

# Feature Flags (Stage 7 & v1.5 features)
FEATURE_PHONE_OTP=false
FEATURE_WAVE=false
FEATURE_FRIENDS=false
